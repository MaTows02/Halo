{
    "manifest_version": 2,
    "minimum_chrome_version": "91",

    "name": "Halo Web",
    "description": "The cutest Discord mod now in your browser",
    "author": "Halo",
    "homepage_url": "https://github.com/MaTows02/Halo",
    "icons": {
        "128": "icon.png"
    },

    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*.discord.com/*",
        "https://raw.githubusercontent.com/*"
    ],

    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["content.js"],
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["dist/Prisme.js"],
            "all_frames": true,
            "world": "MAIN"
        }
    ],

    "background": {
        "scripts": ["background.js"]
    },

    "web_accessible_resources": ["dist/Prisme.js", "dist/Prisme.css", "vendor/*"],

    "browser_specific_settings": {
        "gecko": {
            "id": "halo-firefox@halo.local",
            "strict_min_version": "128.0"
        }
    }
}
